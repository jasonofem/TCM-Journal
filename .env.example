# PostgreSQL connection string (Neon, Supabase Postgres Pooler, or Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/tcm_journal?sslmode=require

# Session signing secret (generate a 32+ char random string for production)
AUTH_SECRET=replace-with-a-strong-random-32-char-secret

# Optional: Admin bootstrap secret required during first-time firm setup if set
ADMIN_BOOTSTRAP_SECRET=
